# Neon Postgres Database URL (lấy từ Dashboard của Neon.tech)
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require"

# Cổng khởi chạy Backend Express Server
PORT=5000

# Cloudflare R2 Storage Configurations (Thay bằng thông số thực tế của bạn)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_bucket_name"
R2_PUBLIC_URL="https://pub-yourbucketid.r2.dev"
